{
  "name": "tmux-helper",
  "version": "0.1.2",
  "description": "A desktop helper for common tmux terminal commands.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-env.js",
    "package:mac": "electron-builder --mac",
    "package:dir": "electron-builder --dir",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "keywords": [
    "tmux",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.local.tmux-helper",
    "productName": "Tmux Helper",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "SprintRay-Software",
      "repo": "Tmux-Helper"
    },
    "files": [
      "!**/.cache/**",
      "!**/cache/**",
      "!**/*.cache",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
